# Nhost (create project at https://app.nhost.io)
# Found in Project Settings > Overview
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
NEXT_PUBLIC_NHOST_REGION=your-region

# Deepgram (get API key at https://console.deepgram.com)
# Signup is free, includes $200 credit
NEXT_PUBLIC_DEEPGRAM_API_KEY=your-deepgram-api-key
